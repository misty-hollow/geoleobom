# 비밀값 — 절대 커밋하지 않는다
.env
.env.*
*.env
!.env.example
!*.env.example
secrets/
*.pem
*.key
id_rsa
id_ed25519

# 원본 데이터와 중간 산출물 — 저장소에 넣지 않는다.
#
# data/README.md가 "원본 CSV(상가정보·심평원·공원)는 저장소에 넣지 않는다(.gitignore)"고
# 적어 두었는데 실제 규칙이 없었다. 문서가 말하는 보호가 실제로는 없던 상태다.
# 원본은 수백 MB이고 출처마다 재배포 조건이 다르므로 확장자와 경로 양쪽으로 막는다.
data/raw/
data/build/

# 표 형식 원본·중간 파일. 저장소에 두는 것은 **작은 합성 픽스처뿐**이다.
# 새로 넣어야 할 작은 파일이 생기면 아래처럼 예외를 한 줄 추가하고 이유를 적는다.
*.csv
!data/fixtures/*.csv
*.tsv
*.xlsx
*.xls
*.zip
*.7z
*.tar.gz
*.tgz

# 대용량 데이터 — 확장자로 막는다.
# 생성 방법·작은 검사 데이터·버전 기록은 저장소에 둔다 (운영 가이드 11절).
# 특정 작은 파일을 넣어야 하면 아래에 예외 한 줄을 추가한다.
*.gpkg
*.gpkg-journal
*.gpkg-wal
*.gpkg-shm
*.osrm
*.osrm.*
*.pbf
*.osm
*.osm.bz2
*.tif
*.tiff
*.sqlite
*.sqlite3
*.db

# Node
node_modules/
dist/
dist-ssr/
build/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# 도구·개인 설정
.claude/settings.local.json
.vscode/settings.json
.vscode/launch.json
.idea/

# OS
Thumbs.db
Desktop.ini
.DS_Store

# 로그·임시
*.log
tmp/
temp/
