# 걸어봄 웹 서버 설정
# 기준: 현재 확정설계(v2.3) 4-1(HTTPS 자동, 정적 파일, /api 프록시), 5절(로그 규약)
#
# 이 도메인은 DNS A 레코드가 가리키는 이름과 정확히 같아야 인증서가 발급된다.
# Caddy는 도메인이 적혀 있으면 인증서 자동 발급·갱신과 http→https 전환을 기본으로 수행한다.

# 필터 필드를 한 곳에만 적는다. 접근 로그와 **전역 기본 로거(오류 로그)** 두 곳에서
# 같은 규칙을 써야 하는데, 두 벌로 적으면 한쪽만 고치는 사고가 난다.
(redacted_fields) {
	fields {
		request>uri regexp "^(/p)/[^?]*|[?].*$" "$1"
		request>headers>Referer delete
		request>headers>Referrer delete
		request>headers>Cookie delete
		request>remote_ip ip_mask {
			ipv4 24
			ipv6 48
		}
	}
}

# 전역 기본 로거. **오류 로그가 여기로 간다.**
#
# 사이트 블록의 `log`는 접근 로그만 설정한다. reverse_proxy 실패 같은 오류는
# 기본 로거로 나가며 필터가 걸리지 않아 **쿼리 문자열과 Referer가 그대로 남았다.**
# 운영 서버에서 실제로 확인한 줄:
#   {"logger":"http.log.error.log0", "request":{"uri":"/api/analyze?lon=127.34500&lat=36.36800",
#    "headers":{"Referer":["https://geoleobom.kr/p/36.47123,127.14020"]}}}
# 접근 로그만 정제하고 끝냈다가 v2.3 5절을 어겼다. 같은 필터를 여기에도 건다.
{
	log default {
		output stderr
		format filter {
			wrap console
			import redacted_fields
		}
	}
}

(redacted_log) {
	# v2.3 5절: 검색어·좌표 원문·/p/{좌표} 경로 파라미터·쿼리 문자열을 로그에 남기지 않는다.
	#
	# 한 필드에는 필터를 하나만 걸 수 있으므로(두 개를 쓰면 뒤엣것만 적용된다) 정규식
	# 하나로 둘 다 처리한다.
	#   ^(/p)/[^?]*  -> /p/{좌표} 경로를 `/p`로 줄인다
	#   [?].*$       -> 쿼리 문자열을 통째로 지운다 (파라미터 이름을 열거하지 않으므로
	#                   나중에 새 파라미터가 생겨도 새지 않는다)
	# `\?` 대신 `[?]`를 쓴다. Caddyfile이 백슬래시를 그대로 넘겨 `\\?`가 "선택적
	# 백슬래시"로 해석되면 경로 전체가 지워진다(실제로 겪었다).
	# 결과: /api/analyze?lon=..&lat=.. -> /api/analyze, /p/36.4,127.1 -> /p
	#
	# Referer는 **통째로 삭제한다.** URI만 정제하면 `/p/{좌표}` 페이지에서 `/api/*`를
	# 부를 때 브라우저가 붙이는 Referer에 좌표가 그대로 남는다(실제로 로그에서 확인했다).
	# 값을 다듬는 대신 지우는 이유는, 공유 URL에 좌표가 들어가는 구조라 Referer가
	# 사실상 항상 민감하기 때문이다. Cookie도 같은 이유로 남기지 않는다.
	log {
		output stdout
		format filter {
			wrap console
			import redacted_fields
		}
	}
}

geoleobom.kr {
	import redacted_log

	# /api/* 는 api 컨테이너로. 외부에 열린 포트는 여기 80/443뿐이다(v2.3 5절).
	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv/site
		file_server
	}
}
